# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (Neon dashboard → Connect → "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Random secret for signing the login cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."
